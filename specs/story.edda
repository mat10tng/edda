entities:
  story:
    is: "one story in a spec_file"
    properties:
      file: spec_file
      id: TEXT, DERIVED
      about: TEXT, DERIVED
      as_a: TEXT, DERIVED
      sentence: TEXT, DERIVED
      epic: TEXT, OPTIONAL, DERIVED
      text: TEXT, DERIVED
      rules_text: TEXT, DERIVED
      blocks: MANY block, IN ORDER, DERIVED
      versions: MANY version, IN ORDER, DERIVED
      version: {computed: "len(versions)"}
      approved: {computed: "versions != [] and rules_text == versions[-1].rules_text"}
      pins_stale: {computed: "versions != [] and any(p.number < p.block.version for p in versions[-1].pins)"}
      changes: MANY change, IN ORDER, DERIVED
      sentences: MANY sentence, IN ORDER, DERIVED
    may_create: [{role: agent}]
    may_read: [{role: agent}, {role: operator}]
    may_update: [{role: agent}, {role: operator}]

  sentence:
    is: "one line of the read view"
    properties:
      kind: story | note | question | operation | permission | refusal | outcome | read | invariant | example | given | when | then
      text: TEXT
      line: NUMBER
      shade: plain | grey | warning

  change:
    is: "one difference between two versions of a story"
    properties:
      kind: added | removed
      line: NUMBER
      sentence: TEXT

stories:
  EDDA-004:
    story: "a story is a draft until the operator approves it"
    about: story
    as_a: operator
    i_want: "a story whose rules differ from its newest approved copy to be a draft, whoever changed it, and a rule whose wording moved away from its meaning flagged"
    so_that: "nothing the agent writes counts until I have said yes"
    epic: VC
    tags: [version, approval]
    notes:
      - "every story here comes from a fixture folder with its history, so the normalised text and rules_text are computed from the source, never supplied"
    examples:
      "a new story is a draft":
        given:
          - spec_file: fresh
            with: {fixture: order}
        steps:
          - then: ["not fresh.stories[0].approved", "fresh.stories[0].version == 0"]
      "a story that matches its newest version is approved":
        given:
          - spec_file: same
            with: {fixture: approved}
        steps:
          - then: ["same.stories[0].approved", "same.stories[0].version == 1"]
      "a changed reason makes a draft again":
        given:
          - spec_file: changed
            with: {fixture: reason_changed}
        steps:
          - then: ["not changed.stories[0].approved", "changed.stories[0].version == 1"]
      "an added refusal and example make a draft again":
        given:
          - spec_file: grown
            with: {fixture: story_grown}
        steps:
          - then: ["not grown.stories[0].approved"]
      "two swapped refusals make a draft again":
        given:
          - spec_file: swapped
            with: {fixture: swapped}
        steps:
          - then: ["not swapped.stories[0].approved"]
      "a changed tag, note, comment or blank line does not make a draft":
        given:
          - spec_file: relabelled
            with: {fixture: relabelled}
        steps:
          - then: ["relabelled.stories[0].approved"]
      "a comment alone does not make a draft":
        given:
          - spec_file: commented
            with: {fixture: comment_changed}
        steps:
          - then: ["commented.stories[0].approved"]
      "a changed reason under an unchanged when is flagged as wording drift":
        given:
          - actor: bot
            with: {roles: [agent]}
          - spec_file: changed
            with: {fixture: reason_changed}
        steps:
          - when: {actor: bot, call: "check(changed)"}
            then:
              - DONE
              - "len(RESULT) == 1"
              - "RESULT[0].kind == flagged"
              - "RESULT[0].rule == wording_drift"
              - "RESULT[0].line == 32"
              - "RESULT[0].message == \"FIX-001 remove: reason changed, when did not\""
      "approval clears the drift":
        given:
          - actor: bot
            with: {roles: [agent]}
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: changed
            with: {fixture: reason_changed}
        steps:
          - when: {actor: tuan, call: "approve(changed.stories[0], because=\"the shop wanted the longer wording\")"}
            then: [DONE, "changed.stories[0].approved"]
          - when: {actor: bot, call: "check(changed)"}
            then: [DONE, "RESULT == []"]

  EDDA-005:
    story: "the operator approves a story and the copy is kept"
    about: story
    as_a: operator
    i_want: "my yes to append the whole story as the next version to the history, with the date, my name, one line of because, and a pin on every entity and role it names"
    so_that: "every approved version is kept exactly, in order, and the agent cannot write it"
    epic: VC
    tags: [version, approval]
    notes:
      - "the agent is kept out of the history by a repository guard outside the language; that guard, and the history surviving a re-read, are level 2 and are tested there"
    operations:
      approve:
        is: "records the operator's yes to a story as its next version"
        inputs: {story: story, because: "TEXT, OPTIONAL"}
        who: [{role: operator}]
        refuse:
          - when: "any(p.kind == refused for p in check(story.file))"
            reason: "the file does not check"
          - when: "any(not b.approved for b in story.blocks)"
            reason: "approve its blocks first"
          - when: "story.approved and not story.pins_stale"
            reason: "nothing to approve: the story matches its newest version and its pins are current"
        ensure:
          - fact: "story.file.history.versions == OLD(story.file.history.versions) + [story.versions[-1]]"
            means: "the earlier entries are kept untouched and exactly one new one is added at the end"
          - "story.versions[-1].number == len(story.versions)"
          - "story.versions[-1].text == story.text"
          - "story.versions[-1].approved_by == ACTOR.name"
          - "story.versions[-1].approved_at == NOW"
          - "story.versions[-1].because == because"
          - fact: "[p.block for p in story.versions[-1].pins] == story.blocks"
            means: "one pin for every entity and role the story names, in that order, no extras"
          - "all(p.number == p.block.version for p in story.versions[-1].pins)"
          - "story.approved"
          - "not story.pins_stale"
    examples:
      "the first approval makes version 1 and pins the blocks":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: good
            with: {fixture: blocks_approved}
        steps:
          - when:
              actor: tuan
              call: "approve(good.stories[0], because=\"the shop asked for it\")"
              at: "2026-10-02 09:00"
            then:
              - DONE
              - "good.stories[0].version == 1"
              - "good.stories[0].versions[0].number == 1"
              - "good.stories[0].versions[0].approved_by == \"tuan\""
              - "good.stories[0].versions[0].approved_at == \"2026-10-02 09:00\""
              - "good.stories[0].versions[0].because == \"the shop asked for it\""
              - "good.stories[0].versions[0].text == good.stories[0].text"
              - "len(good.stories[0].versions[0].pins) == 2"
              - "good.stories[0].versions[0].pins[0].kind == role"
              - "good.stories[0].versions[0].pins[0].name == \"shop_user\""
              - "good.stories[0].versions[0].pins[1].name == \"order\""
              - "good.stories[0].versions[0].pins[1].number == 1"
              - "len(good.history.versions) == 3"
              - "good.stories[0].approved"
              - "not good.stories[0].pins_stale"
      "a second approval keeps the first and adds version 2":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: grown
            with: {fixture: reason_changed}
        steps:
          - when: {actor: tuan, call: "approve(grown.stories[0])", at: "2026-10-02 09:00"}
            then:
              - DONE
              - "grown.stories[0].version == 2"
              - "grown.stories[0].versions[0].number == 1"
              - "grown.stories[0].versions[0].approved_at == \"2026-09-28 10:05\""
              - "grown.stories[0].versions[1].number == 2"
              - "grown.stories[0].versions[1].text == grown.stories[0].text"
              - "grown.stories[0].versions[1].because is None"
              - "grown.stories[0].approved"
      "approving an approved story with current pins is refused":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: same
            with: {fixture: approved}
        steps:
          - when: {actor: tuan, call: "approve(same.stories[0])"}
            then:
              - refused: "nothing to approve: the story matches its newest version and its pins are current"
              - "same.stories[0].version == 1"
      "a story whose blocks have no version is refused":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: fresh
            with: {fixture: order}
        steps:
          - when: {actor: tuan, call: "approve(fresh.stories[0])"}
            then:
              - refused: "approve its blocks first"
              - "fresh.stories[0].version == 0"
      "a story in a file that does not check is refused":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: bad
            with: {fixture: unknown_key}
        steps:
          - when: {actor: tuan, call: "approve(bad.stories[0])"}
            then:
              - refused: "the file does not check"
              - "bad.stories[0].version == 0"
      "the agent may not approve":
        given:
          - actor: bot
            with: {roles: [agent]}
          - spec_file: good
            with: {fixture: blocks_approved}
        steps:
          - when: {actor: bot, call: "approve(good.stories[0])"}
            then:
              - refused: "approve is not allowed for agent"
              - "good.stories[0].version == 0"

  EDDA-006:
    story: "the operator sees what changed before saying yes"
    about: story
    as_a: operator
    i_want: "the difference between the story in the file and its newest approved copy as added and removed lines, in order, so that a moved rule shows too"
    so_that: "I read the change, not the whole story, every time"
    epic: VC
    tags: [version, diff]
    operations:
      diff:
        is: "lists the lines added and removed since the newest version"
        inputs: {story: story}
        who: [{role: agent}, {role: operator}]
        returns: "story.changes"
    examples:
      "an added refusal and example show as added lines":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: grown
            with: {fixture: story_grown}
        steps:
          - when: {actor: tuan, call: "diff(grown.stories[0])"}
            then:
              - DONE
              - "len(RESULT) == 13"
              - "all(c.kind == added for c in RESULT)"
              - "RESULT[0].line == 13"
              - "RESULT[0].sentence == \"        - when: \\\"order.status == removed\\\"\""
              - "RESULT[1].line == 14"
              - "RESULT[2].line == 38"
              - "RESULT[2].sentence == \"    \\\"a removed order is not removed again\\\":\""
      "a changed reason shows as removed and added at the same place, in the rule and in the example":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: reworded
            with: {fixture: reason_changed}
        steps:
          - when: {actor: tuan, call: "diff(reworded.stories[0])"}
            then:
              - DONE
              - "len(RESULT) == 4"
              - "RESULT[0].kind == removed"
              - "RESULT[0].line == 16"
              - "RESULT[0].sentence == \"          reason: \\\"already sent\\\"\""
              - "RESULT[1].kind == added"
              - "RESULT[1].line == 16"
              - "RESULT[1].sentence == \"          reason: \\\"the order has already been sent\\\"\""
              - "RESULT[2].kind == removed"
              - "RESULT[2].line == 37"
              - "RESULT[3].kind == added"
              - "RESULT[3].line == 37"
      "a comment-only edit shows nothing":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: commented
            with: {fixture: comment_changed}
        steps:
          - when: {actor: tuan, call: "diff(commented.stories[0])"}
            then: [DONE, "RESULT == []"]
      "a tag and a note show in the diff and keep the approval":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: relabelled
            with: {fixture: relabelled}
        steps:
          - when: {actor: tuan, call: "diff(relabelled.stories[0])"}
            then:
              - DONE
              - "len(RESULT) == 2"
              - "RESULT[0].sentence == \"  tags: [shop]\""
              - "RESULT[1].sentence == \"  notes: [\\\"the shop asked for undo\\\"]\""
              - "relabelled.stories[0].approved"
      "two swapped refusals show as a removed pair and an added pair":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: swapped
            with: {fixture: swapped}
        steps:
          - when: {actor: tuan, call: "diff(swapped.stories[0])"}
            then:
              - DONE
              - "len(RESULT) == 4"
              - "len([c for c in RESULT if c.kind == removed]) == 2"
              - "len([c for c in RESULT if c.kind == added]) == 2"
              - "RESULT[0].kind == removed"
              - "RESULT[0].line == 13"
              - "RESULT[2].kind == added"
              - "RESULT[2].line == 15"
      "a story never approved shows every line as added":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: fresh
            with: {fixture: order}
        steps:
          - when: {actor: tuan, call: "diff(fresh.stories[0])"}
            then:
              - DONE
              - "len(RESULT) == 48"
              - "all(c.kind == added for c in RESULT)"
              - "RESULT[0].sentence == \"FIX-001:\""

  EDDA-007:
    story: "the operator reads a story as sentences"
    about: story
    as_a: operator
    i_want: "a story shown as plain sentences in its own order, one per rule, with the ids hidden, the notes in grey and the questions marked"
    so_that: "I read the business meaning, never the syntax"
    epic: VIEW
    tags: [read_view]
    notes:
      - "a name reads as words: units_sent reads \"units sent\"; the templates are reference section 12"
    operations:
      view:
        is: "renders the story in the file as sentences"
        inputs: {story: story}
        who: [{role: agent}, {role: operator}]
        returns: "story.sentences"
      view_at:
        is: "renders one approved version of the story as sentences"
        inputs: {story: story, number: NUMBER}
        who: [{role: agent}, {role: operator}]
        refuse:
          - when: "number < 1 or number > story.version"
            reason: "no such version"
        returns: "story.versions[number - 1].sentences"
    examples:
      "the clean fixture reads as twenty sentences":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: good
            with: {fixture: order}
        steps:
          - when: {actor: tuan, call: "view(good.stories[0])"}
            then:
              - DONE
              - "len(RESULT) == 20"
              - "RESULT[0].kind == story"
              - "RESULT[0].text == \"Remove an order. As a shop user, I want to remove an order, so that the list is clean.\""
              - "RESULT[0].line == 17"
              - "RESULT[1].kind == operation"
              - "RESULT[1].text == \"Remove takes an unsent order off the list.\""
              - "RESULT[2].kind == permission"
              - "RESULT[2].text == \"A shop user may remove an order.\""
              - "RESULT[3].kind == refusal"
              - "RESULT[3].text == \"If remove is asked for an order whose status is removed, then the system shall refuse it: already removed.\""
              - "RESULT[4].text == \"If remove is asked for an order whose units sent is more than 0, then the system shall refuse it: already sent.\""
              - "RESULT[5].kind == outcome"
              - "RESULT[5].text == \"When remove succeeds, the order's status is removed.\""
              - "RESULT[6].kind == example"
              - "RESULT[6].text == \"Example: a fresh order is removed.\""
              - "RESULT[7].kind == given"
              - "RESULT[7].text == \"Given erik, a shop user, and purchase, an order with status incoming and units sent 0.\""
              - "RESULT[8].kind == when"
              - "RESULT[8].text == \"When erik asks to remove purchase.\""
              - "RESULT[9].kind == then"
              - "RESULT[9].text == \"Then it is done and purchase's status is removed.\""
              - "RESULT[13].text == \"Then it is refused: already sent, and shipped's status is incoming.\""
              - "RESULT[17].text == \"Then it is done.\""
              - "RESULT[19].text == \"Then it is refused: already removed, and purchase's status is removed.\""
              - "all(s.shade == plain for s in RESULT)"
      "a note reads in its place, grey, and a question after it, marked":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: a
            with: {fixture: notes_a}
        steps:
          - when: {actor: tuan, call: "view(a.stories[0])"}
            then:
              - DONE
              - "RESULT[1].kind == note"
              - "RESULT[1].text == \"the stock feed is refreshed every night\""
              - "RESULT[1].shade == grey"
              - "RESULT[1].line == 24"
              - "RESULT[2].kind == question"
              - "RESULT[2].text == \"does the shop want to see the refresh time?\""
              - "RESULT[2].shade == warning"
              - "RESULT[2].line == 26"
              - "RESULT[3].kind == operation"
              - "RESULT[8].kind == note"
              - "RESULT[8].text == \"a removed order keeps its history\""
      "no sentence shows an id":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: good
            with: {fixture: order}
        steps:
          - when: {actor: tuan, call: "view(good.stories[0])"}
            then: [DONE, "not any(\"FIX-001\" in s.text for s in RESULT)"]
      "an older version reads from its approved copy":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: grown
            with: {fixture: story_grown}
        steps:
          - when: {actor: tuan, call: "view_at(grown.stories[0], 1)"}
            then: [DONE, "not any(\"already removed\" in s.text for s in RESULT)"]
          - when: {actor: tuan, call: "view(grown.stories[0])"}
            then: [DONE, "any(\"already removed\" in s.text for s in RESULT)"]
      "a version that does not exist is refused":
        given:
          - actor: tuan
            with: {roles: [operator]}
          - spec_file: good
            with: {fixture: order}
        steps:
          - when: {actor: tuan, call: "view_at(good.stories[0], 0)"}
            then: [{refused: "no such version"}]
