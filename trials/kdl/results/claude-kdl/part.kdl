entities {
  part {
    is "a stocked auto part the warehouse carries"
    properties {
      code TEXT
      description TEXT
      stock INTEGER
      minimum DEFAULT 1
      status DEFAULT active | discontinued
    }
    may_change { status { active { - discontinued } } }
    may_create { - role=warehouse_staff }
    may_read { - role=warehouse_staff; - role=buyer }
    may_update { - role=warehouse_staff }
  }
}
