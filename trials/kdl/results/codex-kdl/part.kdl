entities {
  part {
    is "an auto part carried by the warehouse"
    properties {
      code TEXT
      description TEXT
      stock INTEGER
      minimum DEFAULT 1
      status DEFAULT active | discontinued
    }
    may_change { status { active { - discontinued } } }
    may_create { - role=warehouse_staff }
    may_read {
      - role=buyer
      - role=warehouse_staff
    }
    may_update { - role=warehouse_staff }
  }
}
