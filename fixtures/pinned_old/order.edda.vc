- entity: order
  number: 1
  approved_at: "2026-09-28 10:00"
  approved_by: tuan
  text: |
      order:
        is: "what a workshop buys"
        properties:
          status: default incoming | removed
          units_sent: default 0
        may_change: {status: {incoming: [removed]}}
        may_update: ["shop_user"]
- story: FIX-001
  number: 1
  approved_at: "2026-09-28 10:05"
  approved_by: tuan
  against: [{entity: order, number: 1}]
  text: |
      FIX-001:
        story: "remove an order"
        about: order
        as_a: shop_user
        i_want: "to remove an order"
        so_that: "the list is clean"
        operations:
          remove:
            inputs: {order: order}
            refuse:
              - when: "the order's units_sent is more than 0"
                reason: "already sent"
            ensure:
              - "the order's status is removed"
        examples:
          "a fresh order is removed":
            given:
              - actor: erik
                roles: [shop_user]
              - order: purchase
                status: incoming
                units_sent: 0
            steps:
              - when: {actor: erik, call: "remove(purchase)"}
                then: [done, "purchase's status is removed"]
- entity: order
  number: 2
  approved_at: "2026-10-01 09:00"
  approved_by: tuan
  because: "nobody may delete an order"
  text: |
      order:
        is: "what a workshop buys"
        properties:
          status: default incoming | removed
          units_sent: default 0
        may_change: {status: {incoming: [removed]}}
        may_update: ["shop_user"]
        may_delete: ["nobody"]
