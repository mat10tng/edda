# Edda keyword registry, generated from language/reference.md (revision 25).
# Every key and every expression form, with what it means, why it exists
# and where it comes from. The checker refuses any key not in schema.json
# and any expression form not here. Hover text in the views comes from
# means and why. A new entry is added like a rule, with a because:.

keys:
  - key: 'roles:'
    section: 'roles'
    means: 'the kinds of actor, person or program'
    why: 'permissions and stories name roles'
    since: v25
  - key: 'is:'
    section: 'roles'
    means: 'one sentence of description'
    why: 'the read view'
    since: v25
  - key: 'has:'
    section: 'roles'
    means: 'the properties a holder of this role has'
    why: 'shop_user whose shop is ... needs a shop'
    since: v25
  - key: 'includes:'
    section: 'roles'
    means: 'every permission line admitting those roles admits this one too, condition included'
    why: "RBAC's role hierarchy"
    since: v25
  - key: 'entities:'
    section: 'entities'
    means: 'the kinds of business object the system keeps'
    why: 'the glossary; every expression is over declared names'
    since: v25
  - key: 'is:'
    section: 'entities'
    means: 'one sentence of description'
    why: 'the read view'
    since: v25
  - key: 'properties:'
    section: 'entities'
    means: 'name to type phrase, or {computed: expr}'
    why: 'the shape the checker and the binding read'
    since: v25
  - key: 'part_of:'
    section: 'entities'
    means: 'this entity belongs to that one'
    why: 'placement and the frame rule follow the owner'
    since: v25
  - key: 'may_change:'
    section: 'entities'
    means: 'per status property, the only allowed changes'
    why: 'a change outside it fails; an unreached status is flagged'
    since: v25
  - key: 'wording:'
    section: 'entities'
    means: 'per value and role, the words shown'
    why: 'the one piece of screen wording kept'
    since: v25
  - key: 'always:'
    section: 'entities'
    means: 'facts that hold after every operation'
    why: 'invariants checked on the suite'
    since: v25
  - key: 'while:'
    section: 'entities'
    means: 'when a condition holds, holds a fact'
    why: 'state-bound invariants, EARS WHILE'
    since: v25
  - key: 'may_create: may_read: may_update: may_delete:'
    section: 'entities'
    means: 'who may, as a list of who-expressions'
    why: 'the CRUD matrix, default deny'
    since: v25
  - key: 'epics:'
    section: 'stories'
    means: 'id to one sentence of intent; no rules'
    why: 'one level above the story, nothing deeper; done when its stories are'
    since: v25
  - key: 'stories:'
    section: 'stories'
    means: 'id to story'
    why: 'the unit of done, review, version and delivery'
    since: v25
  - key: 'story:'
    section: 'stories'
    means: 'the sentence'
    why: 'what the customer said'
    since: v25
  - key: 'about:'
    section: 'stories'
    means: 'the entity it is about'
    why: 'placement, checked'
    since: v25
  - key: 'as_a:'
    section: 'stories'
    means: 'the one role it serves, declared'
    why: 'the read view groups by role'
    since: v25
  - key: 'i_want: so_that:'
    section: 'stories'
    means: 'free text'
    why: 'stored and shown; nothing runs on them'
    since: v25
  - key: 'epic: tags:'
    section: 'stories'
    means: 'labels'
    why: 'grouping; changeable without a new version'
    since: v25
  - key: 'notes:'
    section: 'stories'
    means: 'what the grammar cannot say; ignored by the checker, grey in the view, collected across files'
    why: 'nothing the customer said is lost; repeated notes are the evidence for a new key'
    since: v25
  - key: 'questions:'
    section: 'stories'
    means: 'the undecided'
    why: 'a warning on a done story, never a block'
    since: v25
  - key: 'operations:'
    section: 'operations'
    means: 'name to operation; one thing an actor can ask for'
    why: 'the anchor the code carries'
    since: v25
  - key: 'inputs:'
    section: 'operations'
    means: 'name to type phrase; "text, optional" may be omitted in a call'
    why: 'the binding and placement need the types'
    since: v25
  - key: 'who:'
    section: 'operations'
    means: 'list of who-expressions; optional'
    why: "defaults to the entity's may_update, may_create or may_read"
    since: v25
  - key: 'refuse:'
    section: 'operations'
    means: 'list of when condition and reason; the first that holds is given'
    why: 'preconditions with a reason tests match'
    since: v25
  - key: 'ensure:'
    section: 'operations'
    means: 'list of facts true after; may use old(...)'
    why: 'postconditions'
    since: v25
  - key: 'returns:'
    section: 'operations'
    means: 'the expression a read operation gives back; never with ensure'
    why: 'one word for reads and writes, command-query separation'
    since: v25
  - key: 'ordered_by:'
    section: 'operations'
    means: 'list of expressions over one item, ascending, ties keep input order'
    why: 'without it a positional check on the result is refused'
    since: v25
  - key: 'also_changes:'
    section: 'operations'
    means: 'changes the frame rule allows without an ensure fact'
    why: 'everything else stays unchanged'
    since: v25
  - key: 'examples:'
    section: 'examples'
    means: 'name to example; one concrete run'
    why: 'the acceptance criteria that run'
    since: v25
  - key: 'given:'
    section: 'examples'
    means: 'a list of entities or actors to make: - <entity>: <name> or - actor: <name> with roles:, then properties; fixture: names a fixture folder'
    why: 'names declared here are used below; the binding makes them; no glue is written'
    since: v25
  - key: 'steps:'
    section: 'examples'
    means: 'a list of when and then; when may be left out to check the given state'
    why: 'a flow is several steps'
    since: v25
  - key: 'when:'
    section: 'examples'
    means: 'actor, call (the operation with its arguments, Python call form), at (optional time)'
    why: 'one fixed shape, keys not words'
    since: v25
  - key: 'then:'
    section: 'examples'
    means: 'a list of done, refused: "<reason>", or facts'
    why: 'the checker compares; result is what the latest call returned'
    since: v25

forms:
  - form: "the order's status, order's status, shop's orders"
    means: 'reach into an entity; chains allowed'
    from: 'Edda'
    since: v25
  - form: 'x is v, x is not v'
    means: 'equal, not equal'
    from: 'Edda'
    since: v25
  - form: 'x is more than v, x is less than v, x is at least v, x is at most v'
    means: 'number or time comparison'
    from: 'Edda'
    since: v25
  - form: 'x is before v, x is after v'
    means: 'time comparison'
    from: 'Edda'
    since: v25
  - form: 'x is between a and b'
    means: 'inclusive range'
    from: 'Ruby'
    since: v25
  - form: 'x is empty, x is set'
    means: 'an optional property has no value, has a value'
    from: 'Ruby'
    since: v25
  - form: 'x starts with "t", x is longer than N characters'
    means: 'text'
    from: 'Ruby'
    since: v25
  - form: 'the story is approved, fresh is not approved'
    means: 'a yes/no computed property'
    from: 'Ruby'
    since: v25
  - form: 'a and b, a or b, not a'
    means: 'combined; not first; short-circuit'
    from: 'Python'
    since: v25
  - form: 'a if c else b'
    means: 'conditional; the untaken side is not evaluated'
    from: 'Python'
    since: v25
  - form: 'x in list, x not in list'
    means: 'membership'
    from: 'Python'
    since: v25
  - form: "[x for x in list if c], [y for x in xs for y in x's ys]"
    means: 'filtered and nested lists'
    from: 'Python'
    since: v25
  - form: 'sum(e for x in list), count(list), min, max, any(c for x in list), all(...)'
    means: 'the six list words'
    from: 'Python'
    since: v25
  - form: 'list[0], list[-1], list[1:]'
    means: 'indexing and slicing; out of range fails the example'
    from: 'Python'
    since: v25
  - form: '+ - * /'
    means: 'with Python precedence; + joins lists into a new list'
    from: 'Python'
    since: v25
  - form: '"text" with \\n and \\", "#{x} units"'
    means: 'text; interpolation only in reasons'
    from: 'Python, Ruby'
    since: v25
  - form: '3, 2026-10-03 10:00, 1 hour, now, today, actor, result'
    means: 'literals and the four fixed names; times in the business zone'
    from: 'Edda'
    since: v25
  - form: 'old(x)'
    means: 'the value before the operation'
    from: 'Design by Contract'
    since: v25
  - form: 'check(file) inside an expression'
    means: 'a read operation; never a changing one'
    from: 'Edda'
    since: v25
