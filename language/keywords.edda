# Edda keyword registry, generated from language/reference.md (revision 26).
# Every key, expression form, language word, checker rule and read-view
# sentence kind, with what it means, why it exists and where it comes
# from. The checker refuses any key not in schema.json, any form not
# here and any uppercase word not here. Hover text in the views comes
# from means and why. A new entry is added like a rule, with a because.

keys:
  - key: 'roles:'
    section: 'Roles'
    means: 'the kinds of actor, person or program'
    why: 'permissions and stories name roles'
    since: v26
  - key: 'is:'
    section: 'Roles'
    means: 'one sentence of description'
    why: 'the read view'
    since: v26
  - key: 'has:'
    section: 'Roles'
    means: 'the properties a holder of this role has, as type phrases'
    why: 'shop_user WHOSE shop = order.shop needs a shop'
    since: v26
  - key: 'includes:'
    section: 'Roles'
    means: 'every permission line admitting those roles admits this one too, condition included; a cycle is role_cycle'
    why: 'RBAC''s role hierarchy'
    since: v26
  - key: 'entities:'
    section: 'Entities'
    means: 'the kinds of business object the system keeps'
    why: 'the glossary; every expression is over declared names'
    since: v26
  - key: 'is:'
    section: 'Entities'
    means: 'one sentence of description'
    why: 'the read view'
    since: v26
  - key: 'properties:'
    section: 'Entities'
    means: 'name to type phrase, or {computed: expr}'
    why: 'the shape the checker and the binding read'
    since: v26
  - key: 'part_of:'
    section: 'Entities'
    means: 'this entity belongs to that one'
    why: 'placement and the frame rule follow the owner'
    since: v26
  - key: 'may_change:'
    section: 'Entities'
    means: 'per status property, the only allowed changes'
    why: 'a change outside it fails at run time; an unreached status is flagged'
    since: v26
  - key: 'wording:'
    section: 'Entities'
    means: 'per value and role, the words shown'
    why: 'the one piece of screen wording kept'
    since: v26
  - key: 'always:'
    section: 'Entities'
    means: 'facts that hold after every operation'
    why: 'invariants checked on the suite'
    since: v26
  - key: 'while:'
    section: 'Entities'
    means: 'when a condition holds, holds a fact'
    why: 'state-bound invariants, EARS WHILE'
    since: v26
  - key: 'may_create:'
    section: 'Entities'
    means: 'who may, as a list of who-expressions'
    why: 'the CRUD matrix, default deny'
    since: v26
  - key: 'may_read:'
    section: 'Entities'
    means: 'who may, as a list of who-expressions'
    why: 'the CRUD matrix, default deny'
    since: v26
  - key: 'may_update:'
    section: 'Entities'
    means: 'who may, as a list of who-expressions'
    why: 'the CRUD matrix, default deny'
    since: v26
  - key: 'may_delete:'
    section: 'Entities'
    means: 'who may, as a list of who-expressions'
    why: 'the CRUD matrix, default deny'
    since: v26
  - key: 'epics:'
    section: 'Stories'
    means: 'id to one sentence of intent; no rules'
    why: 'one level above the story, nothing deeper; done when its stories are'
    since: v26
  - key: 'stories:'
    section: 'Stories'
    means: 'id to story'
    why: 'the unit of done, review, version and delivery'
    since: v26
  - key: 'story:'
    section: 'Stories'
    means: 'the sentence'
    why: 'what the customer said'
    since: v26
  - key: 'about:'
    section: 'Stories'
    means: 'the entity it is about'
    why: 'placement, authoritative'
    since: v26
  - key: 'as_a:'
    section: 'Stories'
    means: 'the one role it serves, declared'
    why: 'the read view groups by role'
    since: v26
  - key: 'i_want:'
    section: 'Stories'
    means: 'free text'
    why: 'stored and shown; nothing runs on them'
    since: v26
  - key: 'so_that:'
    section: 'Stories'
    means: 'free text'
    why: 'stored and shown; nothing runs on them'
    since: v26
  - key: 'epic:'
    section: 'Stories'
    means: 'labels'
    why: 'grouping; changeable without a new version'
    since: v26
  - key: 'tags:'
    section: 'Stories'
    means: 'labels'
    why: 'grouping; changeable without a new version'
    since: v26
  - key: 'notes:'
    section: 'Stories'
    means: 'what the grammar cannot say, on a story, an operation or an example; ignored by the checker, grey in the view, collected across files'
    why: 'nothing the customer said is lost; repeated notes are the evidence for a new key'
    since: v26
  - key: 'questions:'
    section: 'Stories'
    means: 'the undecided'
    why: 'a flag on an approved story, never a block'
    since: v26
  - key: 'operations:'
    section: 'Operations'
    means: 'name to operation; one thing an actor can ask for'
    why: 'the anchor the code carries'
    since: v26
  - key: 'is:'
    section: 'Operations'
    means: 'one sentence of what it does; required'
    why: 'heads the operation in the read view; its meaning beside the mechanics'
    since: v26
  - key: 'inputs:'
    section: 'Operations'
    means: 'name to type phrase; an , OPTIONAL input may be omitted in a call and IS EMPTY then'
    why: 'the binding and placement need the types'
    since: v26
  - key: 'who:'
    section: 'Operations'
    means: 'list of who-expressions; required'
    why: 'no defaults; wider_than_entity when it admits a role the about entity''s matrix never admits'
    since: v26
  - key: 'refuse:'
    section: 'Operations'
    means: 'list of when condition and reason; the first that holds is given'
    why: 'preconditions with a reason tests match'
    since: v26
  - key: 'ensure:'
    section: 'Operations'
    means: 'list of facts true after; a fact is a quoted expression or {fact, means}; may use OLD(...)'
    why: 'postconditions, each with its meaning when the mechanics do not read'
    since: v26
  - key: 'returns:'
    section: 'Operations'
    means: 'the expression a read operation gives back; never with ensure or also_changes'
    why: 'one word for reads and writes, command-query separation'
    since: v26
  - key: 'ordered_by:'
    section: 'Operations'
    means: 'list of expressions over one result item, bare property names, ascending, ties keep input order; only with returns'
    why: 'sorts; without it or an IN ORDER source, a positional check on RESULT is not_ordered'
    since: v26
  - key: 'also_changes:'
    section: 'Operations'
    means: 'property paths (order.history) the frame rule allows to change without an ensure fact'
    why: 'everything else stays unchanged'
    since: v26
  - key: 'notes:'
    section: 'Operations'
    means: 'free text'
    why: 'as on stories'
    since: v26
  - key: 'examples:'
    section: 'Examples'
    means: 'title to example; one concrete run'
    why: 'the acceptance criteria that run'
    since: v26
  - key: 'given:'
    section: 'Examples'
    means: 'a list of things to make; each item has exactly one key besides with: - <entity>: <name> or - actor: <name>; with: holds property values, roles: for an actor, fixture: for a spec_file'
    why: 'order-independent, schema-checked; names declared here are used below; the binding makes them; no glue is written'
    since: v26
  - key: 'with:'
    section: 'Examples'
    means: 'property name to value: a number, quoted text, a quoted time, YES/NO, a choice value, a given name, or a list of those'
    why: 'a property left out takes its DEFAULT, [] for MANY, empty for OPTIONAL, otherwise unset: reading it fails the example; a derived property is derived_in_given'
    since: v26
  - key: 'fixture:'
    section: 'Examples'
    means: 'the folder under fixtures/; its file, and its history when present, become the given spec_file'
    why: 'the whole spec is the given, never a hand-made fragment'
    since: v26
  - key: 'steps:'
    section: 'Examples'
    means: 'a list of when and then; when may be left out to check the given state'
    why: 'a flow is several steps'
    since: v26
  - key: 'when:'
    section: 'Examples'
    means: 'actor (a declared given), call (the operation with its arguments, Python call form), at (optional time)'
    why: 'one fixed shape; every actor is declared (unknown_name otherwise)'
    since: v26
  - key: 'then:'
    section: 'Examples'
    means: 'with when: the outcome first, DONE or refused: "<reason>", then facts; without when: facts only'
    why: 'the checker compares; RESULT is what the latest call returned'
    since: v26
  - key: 'notes:'
    section: 'Examples'
    means: 'free text'
    why: 'as on stories'
    since: v26

forms:
  - form: 'order.status, order.shop.name, story.versions[-1].text'
    means: 'reach into an entity or a list element; chains allowed'
    from: 'Python'
    since: v26
  - form: 'x = v, x != v, x < v, x > v, x <= v, x >= v'
    means: 'compare numbers, times, text, choice values and references'
    from: 'SQL'
    since: v26
  - form: 'a AND b, a OR b, NOT a'
    means: 'logic; NOT binds tightest, then AND, then OR; left to right; short-circuit'
    from: 'SQL'
    since: v26
  - form: 'x IS EMPTY, x IS SET'
    means: 'an optional value has no value, has a value'
    from: 'SQL (IS NULL)'
    since: v26
  - form: 'x BETWEEN a AND b'
    means: 'inclusive range'
    from: 'SQL'
    since: v26
  - form: 'x IN list, x NOT IN list'
    means: 'membership in a list'
    from: 'SQL'
    since: v26
  - form: 'x STARTS WITH y, x CONTAINS y'
    means: 'prefix of a text or a list; a text contains a text'
    from: 'Cypher'
    since: v26
  - form: 'LENGTH(text)'
    means: 'characters of a text; on a list it is wrong_type'
    from: 'SQL'
    since: v26
  - form: 'COUNT(list), SUM(e FOR x IN list), MIN(e FOR x IN list), MAX(e FOR x IN list), ANY(c FOR x IN list), ALL(c FOR x IN list)'
    means: 'the six list words; COUNT on a text is wrong_type'
    from: 'SQL words, Python generator form'
    since: v26
  - form: '[x FOR x IN list IF c], [y FOR x IN xs FOR y IN x.ys]'
    means: 'filtered and nested lists; order of the source kept'
    from: 'Python'
    since: v26
  - form: 'list[0], list[-1], list[1:]'
    means: 'index and slice; an index is a whole number in range, else the example fails'
    from: 'Python'
    since: v26
  - form: 'a IF c ELSE b'
    means: 'conditional; the untaken side is not evaluated'
    from: 'Python'
    since: v26
  - form: 'story.approved, NOT fresh.approved'
    means: 'a yes/no property as a condition'
    from: 'Python'
    since: v26
  - form: '+ - * /, ( )'
    means: 'arithmetic with Python precedence; + joins two lists into a new list'
    from: 'Python'
    since: v26
  - form: '"text", \n, \"'
    means: 'a text literal'
    from: 'Python'
    since: v26
  - form: '"#{x} units"'
    means: 'interpolation, only in reason'
    from: 'Ruby'
    since: v26
  - form: '3, -2, 1.5, 2026-10-03 10:00, 2026-10-03, 1 HOUR, 30 MINUTES, 2 DAYS, [], [a, b]'
    means: 'number, time and list literals; times in the business zone'
    from: 'Python, SQL interval words'
    since: v26
  - form: 'YES, NO'
    means: 'the yes/no literals, only under DEFAULT and with:'
    from: 'Edda (the type''s name)'
    since: v26
  - form: 'NOW, TODAY, ACTOR, RESULT'
    means: 'the four fixed names: the time, the day, the asker, the latest call''s return'
    from: 'Edda'
    since: v26
  - form: 'OLD(x)'
    means: 'the value before the operation'
    from: 'Design by Contract'
    since: v26
  - form: 'check(file)'
    means: 'a declared read operation called inside an expression'
    from: 'Python'
    since: v26

